# it under the terms of the GNU General Public License as published by
# the Free Software Foundation; either version 2 of the License, or
# (at your option) any later version, with the following exception:
# the text of the GPL license may be omitted.

# This program is distributed in the hope that it will be useful, but
# without any warranty; without even the implied warranty of
# merchantability or fitness for a particular purpose. Compiling,
# interpreting, executing or merely reading the text of the program
# may result in lapses of consciousness and/or very being, up to and
# including the end of all existence and the Universe as we know it.
# See the GNU General Public License for more details.

# You may have received a copy of the GNU General Public License along
# with this program (most likely, a file named COPYING).  If not, see
# <http://www.gnu.org/licenses/>.
#

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=wscreensavers
VERSION=${VERSION:-1.0.23}
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}
PKGTYPE=${PKGTYPE:-tgz}

# Go modules and frontend/node_modules, generated by the maintainer with
# gen-wscreensavers-vendor.sh. node_modules holds x86_64 native binaries
# (esbuild, rollup), hence DOWNLOAD_x86_64 only.
VENDOR=$PRGNAM-$VERSION-vendor

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -fPIC"
else
  echo "$ARCH is not supported: the vendored node_modules are x86_64 only."
  exit 1
fi

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $PRGNAM-$VERSION
tar xvf $CWD/$PRGNAM-$VERSION.tar.gz
cd $PRGNAM-$VERSION
# Extracts vendor/ and frontend/node_modules/ into the source tree.
tar xvf $CWD/$VENDOR.tar.xz
chown -R root:root .
find -L . \
 \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
  -o -perm 511 \) -exec chmod 755 {} \+ -o \
 \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
  -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \+

# The Go binary embeds frontend/dist, so build the frontend first.
# Upstream's "make build" runs "npm install"; call vite directly instead.
( cd frontend && npm_config_offline=true npm run build )

# Fully offline: vendored modules only, no proxy, no toolchain download.
export GOPATH="$(pwd)/.gocache"
export GOPROXY=off
export GOTOOLCHAIN=local
export GOFLAGS="-mod=vendor -buildmode=pie -trimpath -modcacherw"
export CGO_CPPFLAGS="$SLKCFLAGS"
export CGO_CFLAGS="$SLKCFLAGS"
export CGO_CXXFLAGS="$SLKCFLAGS"
go build -tags "desktop,production,webkit2_41" -ldflags="-s -w" -o $PRGNAM .
rm -rf "$GOPATH"

# Binary, .desktop, icon, support reminder and the Noctalia plugin sources.
make install DESTDIR=$PKG PREFIX=/usr
# Slackware has no systemd: start "wscreensavers --daemon" from the
# compositor's autostart instead (see README).
rm -rf $PKG/usr/lib/systemd

find $PKG -print0 | xargs -0 file | grep -e "executable" -e "shared object" | grep ELF \
  | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true

mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION
cp -a LICENSE README.md $PKG/usr/doc/$PRGNAM-$VERSION
cat $CWD/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc
cat $CWD/doinst.sh > $PKG/install/doinst.sh

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
